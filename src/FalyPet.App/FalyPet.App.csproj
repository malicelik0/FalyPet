<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\FalyPet.Core\FalyPet.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- Bilerek kapalı: UseWindowsForms açıkken örtük using'ler System.Drawing'i de getirir
         ve System.Windows.Point ile System.Drawing.Point çakışır. Her dosya kendi
         using'lerini açıkça yazıyor. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>

    <!-- Tepsi ikonu (NotifyIcon) ve Faz 1'de ekran numaralandırma (Screen) için.
         .NET ile birlikte gelir, ek NuGet paketi yok. -->
    <UseWindowsForms>true</UseWindowsForms>

    <!-- Kurulan exe'nin adı. Proje adı FalyPet.App ama kullanıcı "FalyPet.exe" görmeli. -->
    <AssemblyName>FalyPet</AssemblyName>
    <RootNamespace>FalyPet.App</RootNamespace>

    <!-- WPF'in App.xaml'den urettigi Main yerine kendi giris noktamiz kullaniliyor:
         Velopack ilk satirda calismak zorunda. Ayrinti: Program.cs -->
    <StartupObject>FalyPet.App.Program</StartupObject>
    <!-- Prosedürel yumurtadan üretildi. Tazelemek için IconBuilder'ı çalıştır:
         FalyPet.exe (make-icon anahtarı ile) FalyPet.ico
         Sprite değişirse ikon tek komutla yenilenir, ikisi asla ayrışmaz. -->
    <ApplicationIcon>FalyPet.ico</ApplicationIcon>

    <!-- PerMonitorV2 DPI. Pixel-art bir uygulama için pazarlık dışı: bu olmadan
         farklı ölçekli ikinci monitörde Windows pencereyi bitmap olarak esnetir
         ve 32x32 sprite bulanıklaşır. Ayrıntı: app.manifest -->
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- WFO0003: WinForms analizörü DPI'ın manifest yerine ApplicationHighDpiMode
         ile ayarlanmasını istiyor. Bu bir WPF uygulaması; WinForms yalnızca tepsi
         ikonu ve ekran numaralandırma için referanslı ve ApplicationConfiguration.
         Initialize() hiç çağrılmıyor. WPF'in DPI yolu manifesttir ve çalışan
         pencereye GetWindowDpiAwarenessContext ile sorularak PerMonitorV2
         olduğu doğrulandı. Uyarı bu projede yanlış pozitif. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

</Project>
