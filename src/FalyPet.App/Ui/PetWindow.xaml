<Window x:Class="FalyPet.App.Ui.PetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FalyPet"
        Width="160" Height="160"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!--
        Pencere bilerek küçük tutuluyor. AllowsTransparency=True WPF'i bu pencere için
        yazılımsal çizime düşürür; 160x160'ta maliyeti önemsizdir, büyüdükçe değildir.

        NearestNeighbor pixel art için pazarlık dışı: varsayılan yumuşatma 32x32 bir
        sprite'ı 160x160'a bulanıklaştırarak çizer ve tüm sanatı çöpe atar.
    -->
    <Grid>
        <Image x:Name="SpriteImage"
               Stretch="Fill"
               RenderOptions.BitmapScalingMode="NearestNeighbor"
               RenderTransformOrigin="0.5,1.0">
            <Image.RenderTransform>
                <ScaleTransform x:Name="SpriteScale" ScaleX="1" ScaleY="1" />
            </Image.RenderTransform>
        </Image>
    </Grid>
</Window>
